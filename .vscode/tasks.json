{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OML Linux: Build Development Image",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/linux-dev.sh",
      "args": [
        "build-image"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OML Linux: Open Shell",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/linux-dev.sh",
      "args": [
        "shell"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML Linux: Build Development Image",
      "problemMatcher": []
    },
    {
      "label": "OML Linux: Test ObzLib GCC",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/linux-dev.sh",
      "args": [
        "test-obz-gcc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML Linux: Build Development Image",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OML Linux: Test ObzLib Clang",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/linux-dev.sh",
      "args": [
        "test-obz-clang"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML Linux: Build Development Image",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OML Linux: Test Market Lab GCC",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/linux-dev.sh",
      "args": [
        "test-market-gcc"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML Linux: Build Development Image",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OML Linux: Test Market Lab Clang",
      "type": "shell",
      "command": "${workspaceFolder}/scripts/linux-dev.sh",
      "args": [
        "test-market-clang"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML Linux: Build Development Image",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OML macOS: Configure Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build",
        "-DCMAKE_OSX_SYSROOT=macosx",
        "-DCMAKE_BUILD_TYPE=Debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OML macOS: Build Debug",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML macOS: Configure Debug",
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$gcc"
    },
    {
      "label": "OML macOS: Test All",
      "type": "shell",
      "command": "ctest",
      "args": [
        "--test-dir",
        "build",
        "--output-on-failure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML macOS: Build Debug",
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "problemMatcher": []
    },
    {
      "label": "OML macOS: Test Pipeline",
      "type": "shell",
      "command": "${workspaceFolder}/build/tests/obz_market_engine_tests",
      "args": [
        "[pipeline]"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML macOS: Build Debug",
      "group": "test",
      "problemMatcher": []
    },
    {
      "label": "OML macOS: Run Replay Demo",
      "type": "shell",
      "command": "${workspaceFolder}/build/apps/market_replay/obz_market_replay",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML macOS: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "OML macOS: Run Replay Demo JSONL",
      "type": "shell",
      "command": "${workspaceFolder}/build/apps/market_replay/obz_market_replay",
      "args": [
        "--format",
        "jsonl"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML macOS: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "OML macOS: Run Replay Scenarios",
      "type": "shell",
      "command": "${workspaceFolder}/build/apps/market_replay/obz_market_replay",
      "args": [
        "--directory",
        "scenarios"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML macOS: Build Debug",
      "problemMatcher": []
    },
    {
      "label": "OML macOS: Configure Bench Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build-bench-release",
        "-DCMAKE_OSX_SYSROOT=macosx",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DOBZ_MARKET_LAB_BUILD_TESTS=OFF",
        "-DOBZ_MARKET_LAB_BUILD_BENCHMARKS=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OML macOS: Build Bench Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-bench-release",
        "--target",
        "obz_market_engine_benchmarks",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML macOS: Configure Bench Release",
      "problemMatcher": "$gcc"
    },
    {
      "label": "OML macOS: Benchmark Runner",
      "type": "shell",
      "command": "${workspaceFolder}/build-bench-release/benchmarks/obz_market_engine_benchmarks",
      "args": [
        "--benchmark_filter=runner"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML macOS: Build Bench Release",
      "problemMatcher": []
    },
    {
      "label": "OML macOS: Configure Tracy Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "-S",
        ".",
        "-B",
        "build-tracy-release",
        "-DCMAKE_OSX_SYSROOT=macosx",
        "-DCMAKE_BUILD_TYPE=Release",
        "-DOBZ_MARKET_LAB_BUILD_TESTS=OFF",
        "-DOBZ_MARKET_LAB_BUILD_BENCHMARKS=ON",
        "-DOBZ_MARKET_LAB_ENABLE_TRACY=ON"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "OML macOS: Build Tracy Release",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "build-tracy-release",
        "--target",
        "obz_market_engine_benchmarks",
        "--parallel"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML macOS: Configure Tracy Release",
      "problemMatcher": "$gcc"
    },
    {
      "label": "OML macOS: Tracy Run Runner Benchmark",
      "type": "shell",
      "command": "${workspaceFolder}/build-tracy-release/benchmarks/obz_market_engine_benchmarks",
      "args": [
        "--benchmark_filter=runner_submit_round_trip",
        "--benchmark_min_time=120s"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "dependsOn": "OML macOS: Build Tracy Release",
      "problemMatcher": []
    },
    {
      "label": "OML macOS: Tracy Open Profiler",
      "type": "shell",
      "command": "tracy-profiler",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
